# New Relic > Browser > Application settings > Copy/Paste JavaScript
VITE_NEW_RELIC_ENABLED=true
VITE_NEW_RELIC_BROWSER_LICENSE_KEY=
VITE_NEW_RELIC_BROWSER_APPLICATION_ID=
VITE_NEW_RELIC_ACCOUNT_ID=
VITE_NEW_RELIC_TRUST_KEY=
VITE_NEW_RELIC_AGENT_ID=
VITE_NEW_RELIC_BEACON=bam.nr-data.net
VITE_NEW_RELIC_ERROR_BEACON=bam.nr-data.net

# Azure frontend -> API desplegada en Render. Use el origen, sin ruta final.
VITE_NEW_RELIC_DISTRIBUTED_TRACING_ORIGINS=https://tu-backend.onrender.com

# Opcionales: pueden aumentar la ingesta y requieren revisar privacidad.
VITE_NEW_RELIC_SESSION_TRACE_ENABLED=false
VITE_NEW_RELIC_SESSION_REPLAY_ENABLED=false

# Atributos globales de entorno/despliegue (registrarEntornoNewRelic).
# Si VITE_APP_ENV está vacío se usa el MODE de Vite (production/development).
VITE_APP_ENV=production
VITE_APP_HOST=https://tu-backend.onrender.com
# Inyectar en CI al momento del build, p. ej.: VITE_RELEASE_SHA=$GITHUB_SHA
VITE_RELEASE_SHA=
VITE_RELEASE_BRANCH=
